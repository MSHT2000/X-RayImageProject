            <param name = "streamIndex">
              Stream index.
            </param>
            <param name = "name">
              The name.
            </param>
            <param name = "cutOffHigh">
              Specifies the high cutoff frequency for a specific channel.
            </param>
            <param name = "cutOffLow">
              Specifies the low cutoff frequency for a specific channel.
            </param>
            <param name = "separate">
              Enables or Disables separate cutoff. If Enabled every channel will be 
              processed by it's own cutoff value. If disabled every channel will be processed with 
              the cutoff value of channel 0.
            </param>
            <remarks>
              Filter to cutoff a certain Frequency Range. Each Channel can separate cutoff the Frequency range.
            </remarks>
        </member>
        <member name="M:VisioForge.Core.VideoEdit.VideoEditCore.Audio_Effects_ChannelOrderEx(System.Int32,System.String,System.Byte[0:,0:])">

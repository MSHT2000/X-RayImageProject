            <summary>
            Encrypts the file without reencoding. H264 / AAC files are supported.
            </summary>
            <param name="sourceFile">
            Source file.
            </param>
            <param name="outputFile">
            Output file.
            </param>
            <param name="keyType">
            Key type.
            </param>
            <param name="key">
            Key.
            </param>
            <param name="v9">
            True to use v9 AES-256 encryption SDK engine.
            </param>
            <param name="licenseKey">
            Encryption SDK license key.
            </param>
            <param name="consoleUsage">
            Console usage.
            </param>
            <param name="debugFolder">
            Debug directory.
            </param>
            <param name="customSplitterSource">
            Custom source splitter filter GUID, must support IFileSourceFilter interface.
            </param>
            <returns>
            Returns <see cref="T:System.Boolean"/>.
            </returns>
            <remarks>
            Source file must contain H264 video and / or AAC / PCM audio.
            </remarks>
        </member>
        <member name="M:VisioForge.Core.VideoEdit.VideoEditCore.FastEncrypt_Start(System.String[],System.String,VisioForge.Core.Types.Output.EncryptionKeyType,System.Object,System.Boolean,System.String,System.Boolean,System.String,System.Guid)">

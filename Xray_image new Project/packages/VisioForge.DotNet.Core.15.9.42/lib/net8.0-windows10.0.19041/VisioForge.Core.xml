        <member name="M:VisioForge.Core.VideoEdit.VideoEditCore.Audio_Effects_DS_Chorus(System.Int32,System.String,System.Single,System.Single,System.Single,System.Single,VisioForge.Core.Types.AudioEffects.DSChorusPhase,VisioForge.Core.Types.AudioEffects.DSChorusWaveForm,System.Single)">
            <summary>
              Sets the parameters for the DS Chorus effect.
            </summary>
            <param name = "streamIndex">
              Stream index.
            </param>
            <param name = "name">
              The name.
            </param>
            <param name = "delay">
              Specifies the delay of the filter (0 - 20.0).
            </param>
            <param name = "depth">
              Specifies the depth of the filter (0 - 100.0).
            </param>
            <param name = "feedback">
              Specifies the feedback of the filter (-99.0 - 99.0).
            </param>
            <param name = "frequency">
              Specifies the frequency of the filter (0 - 10.0).
            </param>
            <param name = "phase">

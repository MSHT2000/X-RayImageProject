            <summary>
            Specifies that the format is 4 bits per pixel, indexed.
            </summary>
        </member>
        <member name="F:VisioForge.Core.Types.X.PixelFormatX.Format8bppIndexed">
            <summary>
            Specifies that the format is 8 bits per pixel, indexed. The color table therefore has 256 colors in it.
            </summary>
        </member>
        <member name="F:VisioForge.Core.Types.X.PixelFormatX.Format16bppGrayScale">
            <summary>

        <member name="M:VisioForge.Core.ManagedIStream.System#Runtime#InteropServices#ComTypes#IStream#Read(System.Byte[],System.Int32,System.IntPtr)">
            <summary>
            Read at most bufferSize bytes into buffer and return the effective
            number of bytes read in bytesReadPtr (unless null).
            </summary>
            <param name="buffer">The buffer.</param>
            <param name="bufferSize">Size of the buffer.</param>
            <param name="bytesReadPtr">The bytes read PTR.</param>
            <securitynote>
            Critical: calls Marshal.WriteInt32 which LinkDemands, takes pointers as input.
            </securitynote>
            <remarks>mscorlib disassembly shows the following MarshalAs parameters
            void Read([Out, MarshalAs(UnmanagedType.LPArray, SizeParamIndex=1)] byte[] pv, int cb, IntPtr pcbRead);
            This means marshaling code will have found the size of the array buffer in the parameter bufferSize.</remarks>
        </member>
        <member name="M:VisioForge.Core.ManagedIStream.System#Runtime#InteropServices#ComTypes#IStream#Seek(System.Int64,System.Int32,System.IntPtr)">
            <summary>
            Move the stream pointer to the specified position.
            </summary>
            <param name="offset">The offset.</param>
            <param name="origin">The origin.</param>
            <param name="newPositionPtr">The new position ptr.</param>
            <exception cref="T:System.ArgumentOutOfRangeException">origin.</exception>
            <securitynote>
            Critical: calls Marshal.WriteInt64 which LinkDemands, takes pointers as input.
            </securitynote>
            <remarks>System.IO.stream supports searching past the end of the stream, like
            OLE streams.
            newPositionPtr is not an out parameter because the method is required
            to accept NULL pointers.</remarks>
        </member>
        <member name="M:VisioForge.Core.ManagedIStream.System#Runtime#InteropServices#ComTypes#IStream#SetSize(System.Int64)">
            <summary>
            Sets stream's size.
            </summary>
            <param name="libNewSize">New size.</param>
        </member>
        <member name="M:VisioForge.Core.ManagedIStream.System#Runtime#InteropServices#ComTypes#IStream#Stat(System.Runtime.InteropServices.ComTypes.STATSTG@,System.Int32)">
            <summary>
            Obtain stream stats.
            </summary>
            <param name="streamStats">The stream stats.</param>
            <param name="grfStatFlag">The grf stat flag.</param>
            <exception cref="T:System.IO.IOException">Exception: StreamObjectDisposed.</exception>
            <remarks>STATSG has to be qualified because it is defined both in System.Runtime.InteropServices and
            System.Runtime.InteropServices.ComTypes.
            The STATSTG structure is shared by streams, storages and byte arrays. Members irrelevant to streams
            or not available from System.IO.Stream are not returned, which leaves only cbSize and grfMode as
            meaningful and available pieces of information.
            grfStatFlag is used to indicate whether the stream name should be returned and is ignored because
            this information is unavailable.</remarks>
        </member>
        <member name="M:VisioForge.Core.ManagedIStream.System#Runtime#InteropServices#ComTypes#IStream#Write(System.Byte[],System.Int32,System.IntPtr)">
